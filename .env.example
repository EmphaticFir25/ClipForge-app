# Copy to .env (git-ignored) or set these in the host's secret store. Never commit real values.

# --- required in production
CLIPFORGE_HTTPS_ONLY=1               # redirect plain HTTP and send HSTS
CLIPFORGE_TRUST_PROXY=1              # only when a reverse proxy sets X-Forwarded-Proto
CLIPFORGE_SITE_URL=https://example.com
CLIPFORGE_DATA_KEY=                  # Fernet key for stored platform tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLIPFORGE_APP_DATA=/var/lib/clipforge

# --- email (sign-in links). Without SMTP_HOST, mail is written to <data>/outbox for development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ClipForge <no-reply@example.com>"

# --- billing (Stripe). Start with test keys: sk_test_..., whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# --- publishing. Only platforms that have approved the app.
CLIPFORGE_APPROVED_PLATFORMS=

# --- limits (defaults shown)
# CLIPFORGE_MAX_BODY_BYTES=8592531456
# CLIPFORGE_MEM_KB=8388608           # ffmpeg memory cap, in KB
# CLIPFORGE_CPU_S=1800               # ffmpeg CPU seconds
# CLIPFORGE_WALL_S=1800              # ffmpeg wall-clock seconds
